---
permalink: /site.webmanifest
---
{
  "name": "{{ site.title | default: 'PAWOoM' }}",
  "short_name": "{{ site.title | default: 'PAWOoM' }}",
  "icons": [
    {
      "src": "{{ site.icon_192 | default: '/assets/images/icon-192.png' | relative_url }}",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "{{ site.icon_512 | default: '/assets/images/icon-512.png' | relative_url }}",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "display": "standalone"
}
